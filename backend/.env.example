# ============================================================================
# PAYTM TRUSTBOX CONFIGURATION (.env)
# ============================================================================

# PORT for Backend Server
PORT=3000

# Mode: "MOCK" (Zero-setup instant simulation) or "SANDBOX" (Official Paytm Developer Keys)
PAYTM_ENVIRONMENT=MOCK

# Your Paytm Merchant ID (From https://dashboard.paytm.com -> API Keys)
PAYTM_MID=M12345678

# Your Paytm Merchant Key (From Paytm Developer Dashboard)
PAYTM_MERCHANT_KEY=MOCK_PAYTM_SECRET_KEY_2026

# Merchant Details
MERCHANT_NAME=Rajesh Kirana Store
# Your Real or Test Merchant UPI VPA (e.g. yourname@paytm or paytmqr123@paytm)
MERCHANT_UPI_VPA=rajesh.kirana@paytm

# Ops Alert Webhook (Optional: Slack/Telegram/SMS for >0.70 Fraud Alerts)
OPS_ALERT_WEBHOOK_URL=
