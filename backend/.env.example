# ============================================================================
# PAYTM TRUSTBOX ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

PORT=3000

# ----------------------------------------------------------------------------
# 1. PAYTM PAYMENT GATEWAY CONFIGURATION
# ----------------------------------------------------------------------------
# Set to "MOCK" for instant zero-dependency testing, or "SANDBOX" for Paytm Developer portal
PAYTM_ENVIRONMENT=MOCK

# Paytm Test Credentials from https://dashboard.paytm.com (Developer Settings -> API Keys)
PAYTM_MID=M12345678
PAYTM_MERCHANT_KEY=MOCK_PAYTM_SECRET_KEY_2026

# UPI Identity for QR Code on the 3.2" Screen
MERCHANT_NAME=Rajesh Kirana Store
MERCHANT_UPI_VPA=rajesh.kirana@paytm

# ----------------------------------------------------------------------------
# 2. SPONSOR: SARVAM AI (Indic Voice & Dialect Processing)
# ----------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ----------------------------------------------------------------------------
# 3. SPONSOR: n8n (Automated Incident Response & WhatsApp Alerts)
# ----------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://your-n8n-instance.app/webhook/trustbox-alert
MERCHANT_WHATSAPP_NUMBER=+919876543210
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id

# ----------------------------------------------------------------------------
# 4. SPONSOR: COGNEE (Fraud Memory Graph & Scam Cluster Memory)
# ----------------------------------------------------------------------------
COGNEE_API_KEY=your_cognee_api_key_here
COGNEE_API_URL=https://tenant-a0bd7519-a600-4548-8f50-873593bc3460.aws.cognee.ai
COGNEE_TENANT_ID=a0bd7519-a600-4548-8f50-873593bc3460
